  <!-- INTERACTIVE JS (ACCORDION, STICKY BAR, DYNAMIC SHOPIFY CHECKOUT LINK) -->
  <script>
    (function() {
      // 1. Smooth scroll to pricing
      var checkoutButtons = document.querySelectorAll('.kg-checkout-trigger');
      checkoutButtons.forEach(function(btn) {
        var href = btn.getAttribute('href');
        if (href && href.startsWith('#')) {
          btn.addEventListener('click', function(e) {
            e.preventDefault();
            var target = document.querySelector(href);
            if (target) {
              target.scrollIntoView({ behavior: 'smooth' });
            }
          });
        }
      });

      // 2. FAQ Accordion Toggle
      var faqItems = document.querySelectorAll('.kg-faq-item');
      faqItems.forEach(function(item) {
        var q = item.querySelector('.kg-faq-question');
        if (q) {
          q.addEventListener('click', function() {
            var isActive = item.classList.contains('active');
            faqItems.forEach(function(el) { el.classList.remove('active'); });
            if (!isActive) {
              item.classList.add('active');
            }
          });
        }
      });

      // 3. Sticky Floating CTA on scroll
      var floatingBar = document.getElementById('kgFloatingBar');
      if (floatingBar) {
        window.addEventListener('scroll', function() {
          var scrollY = window.scrollY || window.pageYOffset;
          if (scrollY > 450) {
            floatingBar.classList.add('visible');
          } else {
            floatingBar.classList.remove('visible');
          }
        });
      }
    })();
  </script>
