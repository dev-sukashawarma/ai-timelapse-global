{%- comment -%}
  AI Timelapse — Elegant Hero (editorial / luxury style)
  Paste this file into: Online Store → Themes → Edit code → sections → Add a new section
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Montserrat:wght@400;500&display=swap" rel="stylesheet">

{%- assign sid = section.id | replace: '-', '' -%}

<section class="ath ath-{{ sid }}">
  <div class="ath__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag:
        autoplay: true,
        loop: true,
        muted: true,
        playsinline: true,
        controls: false,
        preload: 'metadata',
        image_size: '1920x',
        class: 'ath__video'
      }}
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'ath__img', loading: 'eager', sizes: '100vw' }}
    {%- endif -%}
  </div>
  <div class="ath__overlay"></div>

  <div class="ath__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ath__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h1 class="ath__title">{{ section.settings.heading }}</h1>
    <span class="ath__rule" aria-hidden="true"></span>

    {%- if section.settings.subheading != blank -%}
      <p class="ath__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a class="ath__btn" href="{{ section.settings.button_link | default: '#' }}">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}

    {%- if section.settings.trust != blank -%}
      <ul class="ath__trust">
        {%- assign items = section.settings.trust | split: '|' -%}
        {%- for item in items -%}
          <li>{{ item | strip }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

<style>
  .ath-{{ sid }} {
    --ath-ink: #FBFAF9;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: {{ section.settings.height }}vh;
    padding: 120px 24px;
    overflow: hidden;
    background: #111111;
    color: var(--ath-ink);
    text-align: center;
    isolation: isolate;
  }
  .ath-{{ sid }} .ath__media,
  .ath-{{ sid }} .ath__overlay {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .ath-{{ sid }} .ath__media video,
  .ath-{{ sid }} .ath__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ath-{{ sid }} .ath__overlay {
    z-index: -1;
    background:
      linear-gradient(180deg,
        rgba(0,0,0,{{ section.settings.overlay | times: 0.006 }}) 0%,
        rgba(0,0,0,{{ section.settings.overlay | times: 0.01 }}) 55%,
        rgba(0,0,0,{{ section.settings.overlay | times: 0.013 | at_most: 0.9 }}) 100%);
  }
  .ath-{{ sid }} .ath__content {
    max-width: 820px;
    margin: 0 auto;
    animation: ath-fade 1.1s ease-out both;
  }
  .ath-{{ sid }} .ath__eyebrow {
    margin: 0 0 22px;
    font-family: 'Montserrat', sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--ath-ink);
    opacity: 0.85;
  }
  .ath-{{ sid }} .ath__title {
    margin: 0;
    font-family: 'Cormorant Garamond', 'Times New Roman', serif;
    font-weight: 400;
    font-size: clamp(40px, 6.4vw, 84px);
    line-height: 1.04;
    letter-spacing: -0.01em;
    color: var(--ath-ink);
    text-wrap: balance;
    text-shadow: 0 2px 30px rgba(0,0,0,0.25);
  }
  .ath-{{ sid }} .ath__rule {
    display: block;
    width: 60px;
    height: 1px;
    margin: 28px auto;
    background: var(--ath-ink);
    opacity: 0.5;
  }
  .ath-{{ sid }} .ath__sub {
    max-width: 560px;
    margin: 0 auto 40px;
    font-family: 'Montserrat', sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.75;
    color: var(--ath-ink);
    opacity: 0.88;
  }
  .ath-{{ sid }} .ath__btn {
    display: inline-block;
    padding: 19px 46px;
    border: 1px solid var(--ath-ink);
    border-radius: 0;
    background: var(--ath-ink);
    color: #111111;
    font-family: 'Montserrat', sans-serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background .3s ease, color .3s ease;
  }
  .ath-{{ sid }} .ath__btn:hover {
    background: transparent;
    color: var(--ath-ink);
  }
  .ath-{{ sid }} .ath__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 0;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
    font-family: 'Montserrat', sans-serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ath-ink);
    opacity: 0.75;
  }
  .ath-{{ sid }} .ath__trust li + li::before {
    content: '·';
    margin: 0 14px;
  }
  @keyframes ath-fade {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }
  @media (max-width: 749px) {
    .ath-{{ sid }} { min-height: {{ section.settings.height_mobile }}vh; padding: 96px 20px; }
    .ath-{{ sid }} .ath__eyebrow { font-size: 10px; letter-spacing: 0.24em; }
    .ath-{{ sid }} .ath__sub { font-size: 15px; }
    .ath-{{ sid }} .ath__btn { display: block; padding: 18px 24px; }
    .ath-{{ sid }} .ath__trust { font-size: 10px; letter-spacing: 0.14em; }
    .ath-{{ sid }} .ath__trust li + li::before { margin: 0 8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ath-{{ sid }} .ath__content { animation: none; }
  }
</style>

{% schema %}
{
  "name": "AI Timelapse Hero",
  "tag": "div",
  "class": "section-ai-timelapse-hero",
  "settings": [
    { "type": "header", "content": "Media" },
    { "type": "video", "id": "video", "label": "Background video" },
    { "type": "image_picker", "id": "image", "label": "Fallback image", "info": "Shown when no video is selected" },
    { "type": "range", "id": "overlay", "label": "Overlay darkness", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 55 },
    { "type": "range", "id": "height", "label": "Height (desktop)", "min": 60, "max": 100, "step": 5, "unit": "vh", "default": 90 },
    { "type": "range", "id": "height_mobile", "label": "Height (mobile)", "min": 60, "max": 100, "step": 5, "unit": "vh", "default": 85 },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "No Camera. No Drone. No Construction Site." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Create Viral AI Timelapse Videos With AI" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Learn the exact AI workflow to turn simple prompts into satisfying construction timelapse videos for TikTok, Instagram Reels, and YouTube Shorts." },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get Instant Access — $19" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "trust", "label": "Trust line", "info": "Separate items with |", "default": "One-Time Payment | Instant Digital Access | Beginner Friendly | No Subscription" }
  ],
  "presets": [
    { "name": "AI Timelapse Hero" }
  ]
}
{% endschema %}
