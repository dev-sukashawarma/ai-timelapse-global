{%- comment -%}
  AI Timelapse — Full Landing Page (High-End Luxury Editorial Edition - Enhanced Typography + Card Video Support + Luxury Footer)
  Install: Online Store → Themes → Edit code → sections → Add a new section → "ai-timelapse-landing"
  Then in the theme editor: Add section → "AI Timelapse Landing"
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600;1,700&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">

{%- liquid
  assign default_product_url = '/products/ai-timelapse-video-generator-masterclass-lifetime-access'
  assign price = section.settings.price
  assign cta = section.settings.cta_link | default: default_product_url
  if cta == '#' or cta == blank
    assign cta = default_product_url
  endif
  assign idea_blocks = section.blocks | where: 'type', 'idea'
  assign review_blocks = section.blocks | where: 'type', 'review'
-%}

<div class="atl" style="--atl-overlay: {{ section.settings.overlay | divided_by: 100.0 }};">

  {%- comment -%} ========== 1. HERO ========== {%- endcomment -%}
  <section class="atl-hero">
    <div class="atl-hero__media">
      {%- if section.settings.hero_video != blank -%}
        {{ section.settings.hero_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1920x' }}
      {%- elsif section.settings.hero_image != blank -%}
        {{ section.settings.hero_image | image_url: width: 2400 | image_tag: loading: 'eager', sizes: '100vw' }}
      {%- endif -%}
    </div>
    <div class="atl-hero__overlay"></div>

    <div class="atl-hero__content">
      <div class="atl-hero__top">
        <span class="atl-hero__badge">Architectural AI Masterclass</span>
        <span class="atl-hero__dot" aria-hidden="true">✦</span>
        {%- if section.settings.hero_eyebrow != blank -%}
          <span class="atl-hero__eyebrow">{{ section.settings.hero_eyebrow }}</span>
        {%- endif -%}
      </div>

      <h1 class="atl-hero__title">{{ section.settings.hero_heading }}</h1>
      
      <p class="atl-hero__sub">{{ section.settings.hero_sub }}</p>
      
      <div class="atl-hero__action">
        <a class="atl-btn atl-btn--gold" href="{{ cta }}">
          <span>Get Instant Access — {{ price }}</span>
        </a>
      </div>

      <ul class="atl-hero__trust">
        <li><span>One-Time Payment</span></li>
        <li><span>Instant Access</span></li>
        <li><span>No Experience Needed</span></li>
        <li><span>Lifetime Updates</span></li>
      </ul>
    </div>
  </section>

  {%- comment -%} ========== 2. WATCH WHAT YOU CAN CREATE ========== {%- endcomment -%}
  <section class="atl-sec atl-paper">
    <div class="atl-wrap">
      <div class="atl-center atl-reveal">
        <p class="atl-label">Showcase &amp; Portfolio</p>
        <h2 class="atl-h2">From Empty Land to a <em>Bespoke Villa</em></h2>
        <div class="atl-lux-divider"><span>✦</span></div>
      </div>

      <div class="atl-watch">
        <div class="atl-watch__frame atl-reveal">
          <div class="atl-watch__video">
            {%- if section.settings.showcase_video != blank -%}
              {{ section.settings.showcase_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '720x' }}
            {%- else -%}
              <div class="atl-placeholder">
                <span>Curated AI Timelapse<br>Showcase</span>
              </div>
            {%- endif -%}
          </div>
        </div>

        <div class="atl-watch__caption atl-reveal">
          <span class="atl-mini-tag">Pure AI Generation</span>
          <p class="atl-watch__italic">From an empty horizon…</p>
          <p class="atl-watch__italic">into an architectural masterpiece.</p>
          <div class="atl-watch__highlight">
            <p class="atl-watch__strong">100% Generated with AI.</p>
            <p class="atl-watch__muted">No cameras. No drones. Zero on-site filming.</p>
          </div>
          <a class="atl-link" href="{{ cta }}">Explore The Workflow &mdash; {{ price }}</a>
        </div>
      </div>

      <div class="atl-ba-wrap atl-reveal">
        <div class="atl-center" style="margin-bottom: 28px;">
          <p class="atl-label">The Metamorphosis</p>
          <p class="atl-ba__title">Interactive Comparison</p>
        </div>
        <div class="atl-ba" style="--pos: 50%;">
          <div class="atl-ba__img atl-ba__before">
            {%- if section.settings.before_image != blank -%}
              {{ section.settings.before_image | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: '(min-width: 1100px) 1100px, 100vw' }}
            {%- else -%}
              <div class="atl-placeholder atl-placeholder--wide"><span>Original Raw Land</span></div>
            {%- endif -%}
          </div>
          <div class="atl-ba__img atl-ba__after">
            {%- if section.settings.after_image != blank -%}
              {{ section.settings.after_image | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: '(min-width: 1100px) 1100px, 100vw' }}
            {%- else -%}
              <div class="atl-placeholder atl-placeholder--wide atl-placeholder--dark"><span>Completed Dream Home</span></div>
            {%- endif -%}
          </div>
          <span class="atl-ba__tag atl-ba__tag--l">01 / Initial Plot</span>
          <span class="atl-ba__tag atl-ba__tag--r">02 / Finished Structure</span>
          <span class="atl-ba__handle" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5"/></svg>
          </span>
          <input class="atl-ba__range" type="range" min="0" max="100" value="50" aria-label="Drag to compare before and after">
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ========== 3. THE STORY ========== {%- endcomment -%}
  <section class="atl-sec atl-white">
    <div class="atl-narrow atl-center">
      <div class="atl-reveal">
        <p class="atl-label">The Digital Shift</p>
        <h2 class="atl-h2">You’ve mesmerized millions<br><em>with content like this.</em></h2>
        <div class="atl-lux-divider"><span>✦</span></div>
      </div>

      <div class="atl-story atl-reveal">
        <p>A quiet plot of raw earth.</p>
        <p>The ground shifts, concrete sets.</p>
        <p>Framing ascends with precision.</p>
        <p>Glass, warm timber, and ambient light…</p>
        <p class="atl-story__big">And in mere seconds, architectural art is born.</p>
      </div>

      <div class="atl-reveal">
        <p class="atl-body">These hypnotic transformations capture millions of views across global feeds every single day.</p>
        <p class="atl-body">Until now, creators spent months and thousands of dollars filming them. Today, state-of-the-art AI allows you to direct these visions directly from your desk.</p>
      </div>

      <div class="atl-problem atl-reveal">
        <span class="atl-mini-tag atl-mini-tag--dark">The True Challenge</span>
        <p class="atl-problem__quote">“Achieving consistency across building phases without distorted geometry or chaotic prompts usually requires hundreds of wasted hours.”</p>
      </div>
    </div>
  </section>

  {%- comment -%} ========== 4. INTRODUCING ========== {%- endcomment -%}
  <section class="atl-sec atl-sand atl-sand--bordered">
    <div class="atl-narrow atl-center atl-reveal">
      <p class="atl-label">The Curated Solution</p>
      <h2 class="atl-wordmark">AI TIMELAPSE<sup>™</sup></h2>
      <p class="atl-edition-tag">Architectural Edition • Vol. I</p>
      <div class="atl-lux-divider"><span>✦</span></div>
      <p class="atl-body atl-body--lead">The definitive blueprint for conceptualizing, generating, and polishing viral AI architectural timelapses.</p>
      <p class="atl-body">No guesswork. No random outputs. Just a refined, predictable creative pipeline.</p>
      <div style="margin-top: 36px;">
        <a class="atl-btn atl-btn--gold" href="{{ cta }}">
          <span>Acquire The Kit — {{ price }}</span>
        </a>
      </div>
    </div>
  </section>

  {%- comment -%} ========== 5. EVERYTHING YOU NEED ========== {%- endcomment -%}
  <section class="atl-sec atl-white">
    <div class="atl-wrap">
      <div class="atl-center atl-reveal">
        <p class="atl-label">Curriculum &amp; Assets</p>
        <h2 class="atl-h2">What Lies Within The Kit</h2>
        <div class="atl-lux-divider"><span>✦</span></div>
      </div>

      <div class="atl-features">
        <article class="atl-feature atl-reveal">
          <div class="atl-feature__header">
            <span class="atl-feature__num">01</span>
            <span class="atl-feature__tag">Module</span>
          </div>
          <h3 class="atl-feature__title">Masterclass Video Training</h3>
          <p>Follow the cohesive step-by-step masterclass: prompt engineering, consistency locks, timeline pacing, and output mastering.</p>
        </article>

        <article class="atl-feature atl-reveal">
          <div class="atl-feature__header">
            <span class="atl-feature__num">02</span>
            <span class="atl-feature__tag">Library</span>
          </div>
          <h3 class="atl-feature__title">Engineered Prompt Archives</h3>
          <p>Battle-tested prompts engineered specifically for structural coherence, realistic textures, and cinematographic lighting.</p>
          <p class="atl-feature__caps">Prompt · Harmonize · Render</p>
        </article>

        <article class="atl-feature atl-reveal">
          <div class="atl-feature__header">
            <span class="atl-feature__num">03</span>
            <span class="atl-feature__tag">Framework</span>
          </div>
          <h3 class="atl-feature__title">Structural Stage Blueprints</h3>
          <p>A proven progression system guaranteeing natural building logic so your audience remains captivated till the final frame.</p>
        </article>

        <article class="atl-feature atl-reveal">
          <div class="atl-feature__header">
            <span class="atl-feature__num">04</span>
            <span class="atl-feature__tag">Pipeline</span>
          </div>
          <h3 class="atl-feature__title">Image-to-Motion Workflow</h3>
          <p>Techniques to convert still concept iterations into seamless, fluid cinematic camera movements with zero artifacting.</p>
        </article>

        <article class="atl-feature atl-reveal">
          <div class="atl-feature__header">
            <span class="atl-feature__num">05</span>
            <span class="atl-feature__tag">Post-Production</span>
          </div>
          <h3 class="atl-feature__title">Luxury Editorial Pacing</h3>
          <p>Simple post-production cuts, sound design tips, and color harmony tuned specifically for high-engagement platforms:</p>
          <p class="atl-feature__caps">Reels · TikTok · Shorts</p>
        </article>

        <article class="atl-feature atl-reveal">
          <div class="atl-feature__header">
            <span class="atl-feature__num">06</span>
            <span class="atl-feature__tag">Toolkit</span>
          </div>
          <h3 class="atl-feature__title">Prompt Generation Engine</h3>
          <p>Generate endless original estate styles, climates, and structural aesthetics automatically whenever you need fresh concepts.</p>
        </article>
      </div>

      <div class="atl-timeline atl-reveal">
        <p class="atl-label atl-center">Architectural Phases Covered</p>
        <ol>
          <li><span>Virgin Terrain</span></li>
          <li><span>Excavation</span></li>
          <li><span>Superstructure</span></li>
          <li><span>Façade</span></li>
          <li><span>Roofing</span></li>
          <li><span>Interior Glow</span></li>
          <li><span>Finished Estate</span></li>
        </ol>
      </div>
    </div>
  </section>

  {%- comment -%} ========== 6. ONE SYSTEM. HUNDREDS OF IDEAS (CARDS: VIDEO OR IMAGE) ========== {%- endcomment -%}
  <section class="atl-sec atl-paper">
    <div class="atl-wrap">
      <div class="atl-center atl-reveal">
        <p class="atl-label">Infinite Variations</p>
        <h2 class="atl-h2">One System.<br><em>Infinite Visions.</em></h2>
        <div class="atl-lux-divider"><span>✦</span></div>
        <div class="atl-narrow">
          <p class="atl-body">From mid-century brutalism to Scandinavian glass retreats, the workflow applies to any stylistic vision.</p>
        </div>
      </div>

      <div class="atl-ideas">
        {%- for block in idea_blocks -%}
          <figure class="atl-idea atl-reveal" {{ block.shopify_attributes }}>
            <div class="atl-idea__inner">
              <div class="atl-idea__img">
                {%- if block.settings.video != blank -%}
                  {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '600x' }}
                {%- elsif block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 220px, 50vw' }}
                {%- else -%}
                  <span class="atl-idea__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                {%- endif -%}
              </div>
            </div>
            <figcaption>
              <span class="atl-idea__index">VOL. {{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="atl-idea__label">{{ block.settings.title }}</span>
            </figcaption>
          </figure>
        {%- endfor -%}
      </div>

      <div class="atl-center atl-reveal" style="margin-top: 48px;">
        <p class="atl-closing">Limitless aesthetics. One elegant workflow.</p>
      </div>
    </div>
  </section>

  {%- comment -%} ========== 7. MADE FOR BEGINNERS ========== {%- endcomment -%}
  <section class="atl-sec atl-white">
    <div class="atl-wrap atl-beginners">
      <div class="atl-beginners__intro atl-reveal">
        <p class="atl-label">Accessibility</p>
        <h2 class="atl-h2">Sophisticated Results.<br><em>Frictionless Entry.</em></h2>
        <p class="atl-closing atl-closing--left">You don't need technical pedigree. Simply follow the curated sequence.</p>
      </div>

      <div class="atl-beginners__list atl-reveal">
        <p class="atl-label atl-label--ink" style="margin-bottom: 12px;">What You Don't Need:</p>
        <ul class="atl-x">
          <li>Expensive cinema cameras or drones</li>
          <li>Architectural degrees or 3D CAD skills</li>
          <li>High-end studio computing rigs</li>
          <li>Complex coding or node programming</li>
          <li>Years of motion graphics experience</li>
        </ul>
      </div>
    </div>
  </section>

  {%- comment -%} ========== 8. REVIEWS ========== {%- endcomment -%}
  {%- if review_blocks.size > 0 -%}
    <section class="atl-sec atl-paper">
      <div class="atl-wrap atl-center">
        <div class="atl-reveal">
          <p class="atl-label">Testimonials</p>
          <h2 class="atl-h2">Words From The Creators</h2>
          <div class="atl-lux-divider"><span>✦</span></div>
        </div>
        <div class="atl-reviews">
          {%- for block in review_blocks -%}
            <blockquote class="atl-review atl-reveal" {{ block.shopify_attributes }}>
              <div class="atl-review__stars">★★★★★</div>
              <p>“{{ block.settings.quote }}”</p>
              <cite>— {{ block.settings.name }}</cite>
            </blockquote>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ========== 9. OFFER ========== {%- endcomment -%}
  <section class="atl-sec atl-sand atl-offer" id="atl-offer">
    <div class="atl-wrap">
      <div class="atl-center atl-reveal">
        <p class="atl-label">Exclusive Acquisition</p>
        <h2 class="atl-h2">Claim Your Access Today</h2>
        <div class="atl-lux-divider"><span>✦</span></div>
      </div>

      <div class="atl-box atl-reveal">
        <div class="atl-box__badge">Full Access Package</div>
        <p class="atl-box__title">The AI Timelapse Creation Suite</p>
        <p class="atl-box__desc">Everything required to produce studio-grade architectural reels.</p>
        
