<style>
  .atl {
    --ink: #0A0A0A;
    --paper: #FAF8F5;
    --sand: #F3EFE9;
    --sand-border: #DFD7CC;
    --muted: #524E48;
    --line: #DFD7CC;
    --gold: #966E3A;
    --gold-light: #DFC49E;
    --serif: 'Cormorant Garamond', 'Didot', 'Bodoni MT', Georgia, serif;
    --sans: 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif;
    color: var(--ink);
    font-family: var(--sans);
    -webkit-font-smoothing: antialiased;
    font-variant-numeric: lining-nums;
    background-color: var(--paper);
  }
  .atl *, .atl *::before, .atl *::after { box-sizing: border-box; }
  :where(.atl) :where(p, h1, h2, h3, ul, ol, figure, blockquote) { margin: 0; }
  .atl img, .atl video { display: block; max-width: 100%; }
  .atl em { font-style: italic; font-family: var(--serif); font-weight: 600; }

  /* ---------- Layout ---------- */
  .atl-sec { padding: 104px 24px; position: relative; }
  .atl-paper { background: var(--paper); }
  .atl-white { background: #FFFFFF; }
  .atl-sand { background: var(--sand); }
  .atl-sand--bordered { border-top: 1px solid var(--sand-border); border-bottom: 1px solid var(--sand-border); }
  .atl-dark { background: #0A0908; color: #FAF8F5; }
  .atl-wrap { max-width: 1160px; margin: 0 auto; }
  .atl-narrow { max-width: 780px; margin: 0 auto; }
  .atl-center { text-align: center; }

  /* ---------- Luxury Ornaments & Divider ---------- */
  .atl-lux-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin: 22px auto 32px;
  }
  .atl-lux-divider::before, .atl-lux-divider::after {
    content: '';
    width: 60px;
    height: 1.5px;
    background: var(--line);
  }
  .atl-lux-divider span {
    font-size: 15px;
    color: var(--gold);
    font-weight: 700;
  }
  .atl-lux-divider--light::before, .atl-lux-divider--light::after {
    background: rgba(255, 255, 255, 0.35);
  }

  .atl-mini-tag {
    display: inline-block;
    padding: 8px 18px;
    margin-bottom: 18px;
    border: 1px solid rgba(150, 110, 58, 0.4);
    background: rgba(255, 255, 255, 0.95);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink);
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }
  .atl-mini-tag--dark {
    border-color: rgba(17,17,17,0.25);
    background: #EFE9E0;
    color: var(--ink);
    font-weight: 600;
  }

  /* ---------- Typography (Enhanced Sizes & Bolder Weight) ---------- */
  .atl-label {
    margin-bottom: 14px;
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .atl-label--ink { color: var(--ink); }
  .atl-label--gold { color: var(--gold-light); }
  
  .atl-h2 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(40px, 5vw, 68px);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: inherit;
    text-wrap: balance;
  }
  .atl-body {
    font-size: 19px;
    font-weight: 400;
    line-height: 1.8;
    color: #242220;
  }
  .atl-body--lead {
    font-size: 22px;
    color: var(--ink);
    font-weight: 500;
    line-height: 1.7;
  }
  .atl-body + .atl-body { margin-top: 16px; }
  .atl-dark .atl-body { color: rgba(250, 248, 245, 0.94); }

  .atl-closing {
    font-family: var(--serif);
    font-size: clamp(28px, 3.2vw, 40px);
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
  }
  .atl-closing--left { margin-top: 22px; font-style: italic; font-weight: 500; color: var(--muted); }

  .atl-small {
    margin-top: 24px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  /* ---------- Luxury Buttons ---------- */
  .atl-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 22px 56px;
    border: 1px solid var(--ink);
    border-radius: 0;
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }
  .atl-btn--gold {
    background: #111111;
    color: #FAF8F5;
    border-color: #111111;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.12);
  }
  .atl-btn--gold::after {
    content: '';
    position: absolute;
    inset: 3px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    pointer-events: none;
    transition: border-color 0.3s ease;
  }
  .atl-btn--gold:hover {
    background: #252422;
    border-color: #252422;
    color: #FAF8F5;
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.22);
  }
  .atl-btn--gold:hover::after {
    border-color: rgba(212, 182, 143, 0.5);
  }

  .atl-dark .atl-btn--gold {
    background: #FAF8F5;
    color: #111111;
    border-color: #FAF8F5;
  }
  .atl-dark .atl-btn--gold::after {
    border-color: rgba(0, 0, 0, 0.18);
  }
  .atl-dark .atl-btn--gold:hover {
    background: #EAE6DE;
    color: #111111;
  }

  .atl-btn--block { display: flex; width: 100%; }

  .atl-link {
    display: inline-block;
    margin-top: 28px;
    padding-bottom: 6px;
    border-bottom: 2px solid var(--gold);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    transition: color 0.3s, border-color 0.3s, transform 0.3s;
  }
  .atl-link:hover { color: var(--gold); transform: translateX(3px); }

  /* ---------- 1. Hero Section ---------- */
  .atl-hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100dvh;
    height: 100vh;
    height: 100dvh;
    padding: 80px 24px 60px;
    overflow: hidden;
    background: #0A0908;
    color: #FAF8F5;
    text-align: center;
    isolation: isolate;
  }
  .atl-hero__media, .atl-hero__overlay { position: absolute; inset: 0; }
  .atl-hero__media { z-index: -2; }
  .atl-hero__media video, .atl-hero__media img { width: 100%; height: 100%; object-fit: cover; }
  .atl-hero__overlay {
    z-index: -1;
    background: 
      linear-gradient(to bottom, rgba(10, 9, 8, 0.95) 0%, rgba(10, 9, 8, 0.45) 18%, rgba(10, 9, 8, 0.15) 35%, rgba(10, 9, 8, 0.3) 70%, rgba(10, 9, 8, 0.9) 100%),
      radial-gradient(circle at center, rgba(0, 0, 0, calc(var(--atl-overlay) * 0.7)) 0%, rgba(0, 0, 0, calc(var(--atl-overlay) * 1.3)) 100%);
  }
  .atl-hero__content {
    width: 100%;
    max-width: 840px;
    margin: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: atl-fade 1s ease-out both;
  }
  .atl-hero__top {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin-bottom: 20px;
    background: transparent;
    border: none;
    padding: 0;
    box-shadow: none;
    text-shadow: 0 2px 10px rgba(0,0,0,0.7);
  }
  .atl-hero__badge {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold-light);
  }
  .atl-hero__dot {
    color: var(--gold-light);
    font-size: 10px;
    opacity: 0.85;
  }
  .atl-hero__eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
  }
  .atl-hero__title {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(42px, 5.8vw, 76px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: #FFFFFF;
    text-wrap: balance;
    max-width: 780px;
    margin: 0 auto 18px;
    text-shadow: 0 4px 28px rgba(0,0,0,0.7);
  }
  .atl-hero__sub {
    max-width: 600px;
    margin: 0 auto;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.94);
    text-shadow: 0 2px 12px rgba(0,0,0,0.6);
  }
  .atl-hero__action {
    margin-top: 30px;
  }
  .atl-hero__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 10px;
    margin-top: 26px;
    padding: 0;
    list-style: none;
  }
  .atl-hero__trust li {
    display: inline-flex;
    align-items: center;
  }
  .atl-hero__trust li span {
    display: inline-block;
    padding: 6px 14px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(10, 9, 8, 0.45);
    backdrop-filter: blur(8px);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
  }

  /* ---------- 2. Watch Section ---------- */
  .atl-watch {
    display: grid;
    grid-template-columns: minmax(0, 400px) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
    max-width: 1020px;
    margin: 48px auto 0;
  }
  .atl-watch__frame {
    padding: 12px;
    background: #FFFFFF;
    border: 1px solid var(--line);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);
  }
  .atl-watch__video {
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background: var(--ink);
  }
  .atl-watch__video video { width: 100%; height: 100%; object-fit: cover; }
  .atl-watch__caption {
    text-align: left;
  }
  .atl-watch__italic {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(30px, 3.4vw, 44px);
    line-height: 1.25;
    color: #2F2D2A;
  }
  .atl-watch__highlight {
    margin-top: 28px;
    padding: 8px 0 8px 24px;
    border-left: 3px solid var(--gold);
  }
  .atl-watch__strong {
    font-family: var(--serif);
    font-weight: 700;
    font-size: clamp(28px, 2.8vw, 36px);
    line-height: 1.2;
    color: var(--ink);
  }
  .atl-watch__muted {
    font-size: 17px;
    color: var(--muted);
    font-weight: 500;
    line-height: 1.6;
    margin-top: 8px;
  }

  .atl-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 100%;
    background: #EAE6DF;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 600;
    font-size: 24px;
    color: var(--muted);
    text-align: center;
  }
  .atl-placeholder--dark { background: #262422; color: #D4B68F; }

  /* Before / After */
  .atl-ba-wrap { max-width: 1080px; margin: 96px auto 0; }
  .atl-ba__title {
    font-family: var(--serif);
    font-size: 34px;
    font-weight: 600;
    color: var(--ink);
    margin-top: 6px;
  }
  .atl-ba {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    user-select: none;
    border: 1px solid var(--line);
    box-shadow: 0 12px 40px rgba(0,0,0,0.06);
    background: var(--sand);
  }
  .atl-ba__img { position: absolute; inset: 0; }
  .atl-ba__img img { width: 100%; height: 100%; object-fit: cover; }
  .atl-ba__after { clip-path: inset(0 0 0 var(--pos)); }
  .atl-ba::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    background: #FFFFFF;
    box-shadow: 0 0 10px rgba(0,0,0,0.5);
    pointer-events: none;
  }
  .atl-ba__handle {
    position: absolute;
    top: 50%;
    left: var(--pos);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border: 2px solid #FFFFFF;
    border-radius: 50%;
    background: rgba(10, 9, 8, 0.75);
    color: #FFFFFF;
    transform: translate(-50%, -50%);
    pointer-events: none;
    backdrop-filter: blur(8px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.3);
  }
  .atl-ba__tag {
    position: absolute;
    bottom: 22px;
    z-index: 2;
    padding: 10px 18px;
    background: rgba(10, 9, 8, 0.9);
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    pointer-events: none;
    border: 1px solid rgba(255,255,255,0.25);
  }
  .atl-ba__tag--l { left: 22px; }
  .atl-ba__tag--r { right: 22px; }
  .atl-ba__range {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  /* ---------- 3. Story ---------- */
  .atl-story { margin-bottom: 44px; }
  .atl-story p {
    font-family: var(--serif);
    font-size: clamp(28px, 3.2vw, 38px);
    font-weight: 500;
    line-height: 1.55;
    color: #4A4642;
  }
  .atl-story .atl-story__big {
    margin-top: 28px;
    font-weight: 700;
    font-size: clamp(32px, 3.8vw, 48px);
    line-height: 1.25;
    color: var(--ink);
    text-wrap: balance;
  }
  .atl-problem {
    margin-top: 64px;
    padding: 54px 40px;
    border-top: 2px solid var(--line);
    border-bottom: 2px solid var(--line);
    background: var(--paper);
  }
  .atl-problem__quote {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(26px, 3vw, 36px);
    line-height: 1.45;
    color: var(--ink);
    text-wrap: balance;
  }

  /* ---------- 4. Introducing Wordmark ---------- */
  .atl-wordmark {
    margin: 10px 0 16px;
    font-family: var(--serif);
    font-weight: 700;
    font-size: clamp(52px, 8vw, 106px);
    line-height: 1;
    letter-spacing: 0.05em;
    color: var(--ink);
  }
  .atl-wordmark sup { font-size: 0.3em; vertical-align: super; font-weight: 600; }
  .atl-edition-tag {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 14px;
  }

  /* ---------- 5. Features Grid ---------- */
  .atl-features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px 36px;
    margin-top: 48px;
  }
  .atl-feature {
    padding: 34px 30px;
    border: 1px solid var(--line);
    background: #FFFFFF;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .atl-feature:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 36px rgba(0,0,0,0.07);
  }
  .atl-feature__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
  }
  .atl-feature__num {
    font-family: var(--serif);
    font-weight: 700;
    font-size: 36px;
    line-height: 1;
    color: var(--gold);
  }
  .atl-feature__tag {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .atl-feature__title {
    margin-bottom: 14px;
    font-family: var(--serif);
    font-weight: 700;
    font-size: 28px;
    line-height: 1.25;
    color: var(--ink);
  }
  .atl-feature p {
    font-size: 17px;
    font-weight: 400;
    line-height: 1.75;
    color: #2F2D2A;
  }
  .atl-feature__caps {
    margin-top: 18px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
  }

  /* Phase timeline */
  .atl-timeline { margin-top: 96px; }
  .atl-timeline ol {
    display: flex;
    margin-top: 32px;
    padding: 0;
    list-style: none;
    counter-reset: atl-step;
  }
  .atl-timeline li {
    position: relative;
    flex: 1;
    padding-top: 36px;
    text-align: center;
    counter-increment: atl-step;
  }
  .atl-timeline li span {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 22px;
    color: var(--ink);
  }
  .atl-timeline li::before {
    content: '';
    position: absolute;
    top: 5px;
    left: 50%;
    z-index: 1;
    width: 12px;
    height: 12px;
    border: 2px solid var(--gold);
    border-radius: 50%;
    background: #FFFFFF;
    transform: translateX(-50%);
  }
  .atl-timeline li:last-child::before { background: var(--gold); }
  .atl-timeline li + li::after {
    content: '';
    position: absolute;
    top: 10px;
    right: 50%;
    width: 100%;
    height: 2px;
    background: var(--line);
  }

  /* ---------- 6. Ideas Gallery (Cards with Video Support) ---------- */
  .atl-ideas {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 26px 18px;
    margin-top: 44px;
  }
  .atl-idea__inner {
    padding: 7px;
    border: 1px solid var(--line);
    background: #FFFFFF;
  }
  .atl-idea__img {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #EAE6DF;
  }
  .atl-idea__img img,
  .atl-idea__img video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }
  .atl-idea:hover .atl-idea__img img,
  .atl-idea:hover .atl-idea__img video {
    transform: scale(1.06);
  }
  .atl-idea__num {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 600;
    font-size: 40px;
    color: #9C968C;
  }
  .atl-idea figcaption {
    margin-top: 14px;
    text-align: center;
  }
  .atl-idea__index {
    display: block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.24em;
    color: var(--gold);
    margin-bottom: 5px;
  }
  .atl-idea__label {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }

  /* ---------- 7. Beginners ---------- */
  .atl-beginners {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .atl-x { padding: 0; list-style: none; }
  .atl-x li {
    position: relative;
    padding: 20px 0 20px 44px;
    border-bottom: 1px solid var(--line);
    font-family: var(--serif);
    font-weight: 600;
    font-size: 26px;
    color: #1F1D1B;
  }
  .atl-x li:first-child { border-top: 1px solid var(--line); }
  .atl-x li::before, .atl-x li::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 8px;
    width: 16px;
    height: 2px;
    background: var(--gold);
  }
  .atl-x li::before { transform: rotate(45deg); }
  .atl-x li::after { transform: rotate(-45deg); }

  /* ---------- 8. Reviews ---------- */
  .atl-reviews {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px;
    margin-top: 44px;
    text-align: center;
  }
  .atl-review {
    padding: 44px 34px;
    border: 1px solid var(--line);
    background: #FFFFFF;
  }
  .atl-review__stars {
    color: var(--gold);
    letter-spacing: 0.32em;
    font-size: 16px;
    margin-bottom: 20px;
    font-weight: 700;
  }
  .atl-review p {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 600;
    font-size: 26px;
    line-height: 1.5;
    color: #1F1D1B;
  }
  .atl-review cite {
    display: block;
    margin-top: 20px;
    font-style: normal;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ---------- 9. Offer Box ---------- */
  .atl-box {
    max-width: 660px;
    margin: 44px auto 0;
    padding: 56px 52px 48px;
    border: 2px solid var(--ink);
    background: #FFFFFF;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
    text-align: center;
    position: relative;
  }
  .atl-box__badge {
    display: inline-block;
    padding: 6px 18px;
    background: var(--ink);
    color: #FAF8F5;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .atl-box__title {
    font-family: var(--serif);
    font-size: 36px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 10px;
  }
  .atl-box__desc {
    font-size: 17px;
    font-weight: 400;
