          <li>Automated Prompt Generator Access</li>
          <li>Complimentary Lifetime System Upgrades</li>
        </ul>

        <div class="atl-price">
          {%- if section.settings.compare_price != blank -%}
            <s class="atl-price__compare">{{ section.settings.compare_price }}</s>
          {%- endif -%}
          <span class="atl-price__now">{{ price }}</span>
          <p class="atl-price__caps">One-Time Private Access</p>
          <p class="atl-price__note">No subscriptions. Immediate unlocked entry.</p>
        </div>

        <a class="atl-btn atl-btn--gold atl-btn--block" href="{{ cta }}">
          <span>Unlock Instant Access — {{ price }}</span>
        </a>
        <p class="atl-box__foot">Direct access delivered via email immediately following checkout.</p>
      </div>
    </div>
  </section>

