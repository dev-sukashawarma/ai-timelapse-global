  @media (max-width: 580px) {
    .atl-footer {
      padding: 60px 20px 40px;
    }
    .atl-footer__top {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .atl-footer__trust {
      flex-direction: column;
