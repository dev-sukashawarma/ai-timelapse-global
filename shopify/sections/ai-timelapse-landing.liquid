  /* ---------- 12. Sticky Mobile CTA ---------- */
  .atl-sticky { display: none; }

  /* ---------- Animation ---------- */
  .atl--js .atl-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
  .atl--js .atl-reveal.is-in { opacity: 1; transform: none; }
  @keyframes atl-fade {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 989px) {
    .atl-features { grid-template-columns: repeat(2, minmax(0, 1fr)); }
