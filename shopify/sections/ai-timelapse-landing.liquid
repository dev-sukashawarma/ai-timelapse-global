    .atl-watch { grid-template-columns: 1fr; text-align: center; }
    .atl-watch__caption { text-align: center; }
    .atl-watch__frame { max-width: 340px; margin: 0 auto; }
    .atl-watch__highlight { border-left: none; padding-left: 0; }
    
    .atl-ba-wrap { margin-top: 60px; }
    .atl-ba { aspect-ratio: 4 / 5; }

    .atl-features { grid-template-columns: 1fr; gap: 26px; }
    .atl-timeline ol { flex-direction: column; gap: 0; max-width: 280px; margin: 28px auto 0; }
    .atl-timeline li { padding: 0 0 24px 36px; text-align: left; }
    .atl-timeline li span { font-size: 20px; font-weight: 600; }
    .atl-timeline li::before { top: 6px; left: 4px; transform: none; }
    .atl-timeline li + li::after { top: -14px; right: auto; left: 9px; width: 2px; height: 24px; }

    .atl-ideas { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 14px; }
    .atl-box { padding: 44px 24px 36px; }
    .atl-price__now { font-size: 84px; }

    .atl-sticky {
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 20px calc(14px + env(safe-area-inset-bottom));
      border-top: 1px solid var(--line);
      background: rgba(250, 248, 245, 0.96);
      backdrop-filter: blur(10px);
      transform: translateY(110%);
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .atl-sticky.is-visible { transform: none; }
    .atl-sticky__info { display: flex; flex-direction: column; text-align: left; }
    .atl-sticky__tag { font-size: 12px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); }
    .atl-sticky__price { font-family: var(--serif); font-size: 24px; font-weight: 700; color: var(--ink); }
    .atl-sticky__btn {
      padding: 14px 28px;
      background: var(--ink);
      color: #FAF8F5;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      text-decoration: none;
